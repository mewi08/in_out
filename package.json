{
  "name": "inout",
  "version": "1.0.0",
  "description": "Attendance registration system",
  "main": "electron/main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:setup": "node scripts/dbSetup.js",
    "create-admin": "node scripts/admin.js",
    "electron": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.inout.app",
    "productName": "InOut",
    "asar": true,
    "files": [
      "**/*",
      "!dist/**/*",
      "!logs/**/*"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "win": {
      "target": "nsis"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.20.0",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.1.14"
  }
}